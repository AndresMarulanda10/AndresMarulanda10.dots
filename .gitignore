.DS_Store

# Local environment / secrets
.env
.env.*
*.local
!.gitconfig.local.example

# Installer backups
*.backup.*

# Editor / OS noise
.idea/
.vscode/.ropeproject/
*.swp
*.swo

# Logs / caches
*.log
.cache/

# Local Gentle AI metadata
/.atl/

# Local CodeGraph index
/.codegraph/

# Only the portable theme is public, never OpenCode runtime configuration.
/opencode/*
!/opencode/themes/
/opencode/themes/*
!/opencode/themes/dracula-terminal.json
